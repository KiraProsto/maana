# Секрет для подписи сессии админки (не короче 32 символов)
# Сгенерировать: openssl rand -base64 48
SESSION_SECRET=

# Разработчик
ADMIN_DEVELOPER_LOGIN=
ADMIN_DEVELOPER_PASSWORD_HASH=

# Админ (заказчица)
ADMIN_OWNER_LOGIN=
ADMIN_OWNER_PASSWORD_HASH=

# Для локальной проверки каталога на PostgreSQL задайте CATALOG_SOURCE=database.
DATABASE_URL=
CATALOG_SOURCE=

# Постоянная папка с загруженными фото. По умолчанию data/product-uploads.
PRODUCT_UPLOAD_DIR=

# ЮKassa. Для локальной проверки используй реквизиты тестового магазина.
YOKASSA_SHOP_ID=
YOKASSA_SECRET_KEY=
SITE_URL=http://localhost:3000
RESEND_API_KEY=
ORDERS_EMAIL=

# Приватный S3 для загрузок из админки. Пустые поля оставляют загрузки на локальном диске.
MEDIA_S3_BUCKET=
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
